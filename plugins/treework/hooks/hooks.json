{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/pre_tool_use.sh",
            "timeout": 15,
            "statusMessage": "Checking TreeWork generated-state guardrails"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/stop.sh",
            "timeout": 30,
            "statusMessage": "Preparing TreeWork stop summary"
          }
        ]
      }
    ]
  }
}
