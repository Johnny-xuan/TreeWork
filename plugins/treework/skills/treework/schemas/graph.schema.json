{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreeWork Branch Graph",
  "type": "object",
  "required": ["edges"],
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kind", "user_label", "interpreted_relation"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string" },
          "user_label": { "type": "string" },
          "interpreted_relation": { "type": "string" }
        }
      }
    }
  }
}
