{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treework.local/schemas/tree-state.schema.json",
  "title": "TreeWork Accepted Tree State",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "source_hash",
    "state_hash",
    "accepted_at",
    "root",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_hash": {
      "type": "string",
      "minLength": 1
    },
    "state_hash": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "const": "root"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "parent",
        "title",
        "purpose",
        "sibling_order",
        "depends_on"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        },
        "sibling_order": {
          "type": "integer",
          "minimum": 0
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
